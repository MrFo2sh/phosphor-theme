{
  "name": "phosphor-theme",
  "one_liner": "Retro phosphor-green VS Code colour theme matching Agent Globe.",
  "blueprint": "vscode-theme",
  "version": "0.1.0",
  "check": ["lint", "build"],
  "stopOnFail": true,
  "commands": {
    "install": "",
    "lint": "node -e \"for (const f of ['package.json','themes/phosphor-color-theme.json']) JSON.parse(require('fs').readFileSync(f,'utf8')); console.log('json ok')\"",
    "typecheck": "",
    "test": "",
    "build": "npx --yes @vscode/vsce package --allow-missing-repository -o phosphor.vsix",
    "audit": "",
    "run": "code --install-extension phosphor.vsix --force",
    "release": "npx --yes @vscode/vsce package --allow-missing-repository -o phosphor.vsix"
  }
}
