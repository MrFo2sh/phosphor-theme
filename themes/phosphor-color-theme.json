{
  "$schema": "vscode://schemas/color-theme",
  "name": "Agent Globe Phosphor",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#020a04",
    "editor.foreground": "#96ebaa",
    "editorLineNumber.foreground": "#2f6b43",
    "editorLineNumber.activeForeground": "#6eff96",
    "editorCursor.foreground": "#6eff96",
    "editor.selectionBackground": "#0a5023",
    "editor.selectionHighlightBackground": "#0a502380",
    "editor.inactiveSelectionBackground": "#0a502360",
    "editor.lineHighlightBackground": "#04180a",
    "editor.lineHighlightBorder": "#0d3a1c",
    "editor.wordHighlightBackground": "#0d3a1c80",
    "editor.findMatchBackground": "#ffcd5060",
    "editor.findMatchHighlightBackground": "#ffcd5030",
    "editorIndentGuide.background1": "#0d3a1c",
    "editorIndentGuide.activeBackground1": "#2f6b43",
    "editorWhitespace.foreground": "#0d3a1c",
    "editorBracketMatch.background": "#0d3a1c",
    "editorBracketMatch.border": "#6eff96",
    "editorGutter.addedBackground": "#6eff96",
    "editorGutter.modifiedBackground": "#ffcd50",
    "editorGutter.deletedBackground": "#ff5f50",
    "editorWidget.background": "#030f06",
    "editorWidget.border": "#14461f",
    "editorSuggestWidget.background": "#030f06",
    "editorSuggestWidget.border": "#14461f",
    "editorSuggestWidget.selectedBackground": "#0a5023",
    "editorHoverWidget.background": "#030f06",
    "editorHoverWidget.border": "#14461f",
    "editorError.foreground": "#ff5f50",
    "editorWarning.foreground": "#ffcd50",
    "editorInfo.foreground": "#6eff96",
    "errorForeground": "#ff5f50",

    "foreground": "#96ebaa",
    "descriptionForeground": "#3c8c55",
    "focusBorder": "#6eff96",
    "widget.shadow": "#000000aa",
    "selection.background": "#0a5023",
    "icon.foreground": "#6eff96",

    "sideBar.background": "#020a04",
    "sideBar.foreground": "#96ebaa",
    "sideBar.border": "#14461f",
    "sideBarTitle.foreground": "#3c8c55",
    "sideBarSectionHeader.background": "#04180a",
    "sideBarSectionHeader.foreground": "#6eff96",
    "sideBarSectionHeader.border": "#14461f",

    "activityBar.background": "#010603",
    "activityBar.foreground": "#6eff96",
    "activityBar.inactiveForeground": "#2f6b43",
    "activityBar.border": "#14461f",
    "activityBarBadge.background": "#ffcd50",
    "activityBarBadge.foreground": "#020a04",

    "titleBar.activeBackground": "#010603",
    "titleBar.activeForeground": "#6eff96",
    "titleBar.inactiveBackground": "#010603",
    "titleBar.inactiveForeground": "#2f6b43",
    "titleBar.border": "#14461f",
    "menu.background": "#030f06",
    "menu.foreground": "#96ebaa",
    "menu.selectionBackground": "#0a5023",
    "menubar.selectionBackground": "#0a5023",

    "statusBar.background": "#010603",
    "statusBar.foreground": "#6eff96",
    "statusBar.border": "#14461f",
    "statusBar.debuggingBackground": "#ffcd50",
    "statusBar.debuggingForeground": "#020a04",
    "statusBar.noFolderBackground": "#010603",
    "statusBarItem.remoteBackground": "#0a5023",
    "statusBarItem.remoteForeground": "#6eff96",
    "statusBarItem.hoverBackground": "#0a5023",

    "tab.activeBackground": "#020a04",
    "tab.activeForeground": "#6eff96",
    "tab.activeBorderTop": "#6eff96",
    "tab.inactiveBackground": "#010603",
    "tab.inactiveForeground": "#3c8c55",
    "tab.border": "#14461f",
    "editorGroupHeader.tabsBackground": "#010603",
    "editorGroupHeader.tabsBorder": "#14461f",
    "editorGroup.border": "#14461f",
    "breadcrumb.foreground": "#3c8c55",
    "breadcrumb.focusForeground": "#6eff96",
    "breadcrumb.activeSelectionForeground": "#6eff96",

    "panel.background": "#020a04",
    "panel.border": "#14461f",
    "panelTitle.activeForeground": "#6eff96",
    "panelTitle.activeBorder": "#6eff96",
    "panelTitle.inactiveForeground": "#3c8c55",

    "input.background": "#04180a",
    "input.foreground": "#96ebaa",
    "input.border": "#14461f",
    "input.placeholderForeground": "#2f6b43",
    "inputOption.activeBorder": "#6eff96",
    "inputOption.activeBackground": "#0a5023",
    "dropdown.background": "#04180a",
    "dropdown.foreground": "#96ebaa",
    "dropdown.border": "#14461f",
    "checkbox.background": "#04180a",
    "checkbox.border": "#14461f",

    "button.background": "#0e4a1f",
    "button.foreground": "#aaffbe",
    "button.hoverBackground": "#14661f",
    "button.secondaryBackground": "#04180a",
    "button.secondaryForeground": "#96ebaa",
    "badge.background": "#ffcd50",
    "badge.foreground": "#020a04",
    "progressBar.background": "#6eff96",

    "list.activeSelectionBackground": "#0a5023",
    "list.activeSelectionForeground": "#aaffbe",
    "list.inactiveSelectionBackground": "#04180a",
    "list.hoverBackground": "#04180a",
    "list.focusOutline": "#6eff96",
    "list.highlightForeground": "#ffcd50",
    "list.errorForeground": "#ff5f50",
    "list.warningForeground": "#ffcd50",
    "tree.indentGuidesStroke": "#14461f",

    "scrollbar.shadow": "#000000",
    "scrollbarSlider.background": "#14461f80",
    "scrollbarSlider.hoverBackground": "#2f6b43a0",
    "scrollbarSlider.activeBackground": "#3c8c55c0",
    "minimap.background": "#010603",
    "minimapSlider.background": "#14461f60",

    "terminal.background": "#010603",
    "terminal.foreground": "#96ebaa",
    "terminalCursor.foreground": "#6eff96",
    "terminal.selectionBackground": "#0a5023",
    "terminal.ansiBlack": "#030f06",
    "terminal.ansiRed": "#ff5f50",
    "terminal.ansiGreen": "#6eff96",
    "terminal.ansiYellow": "#ffcd50",
    "terminal.ansiBlue": "#3cb371",
    "terminal.ansiMagenta": "#c8ffc8",
    "terminal.ansiCyan": "#aaffbe",
    "terminal.ansiWhite": "#96ebaa",
    "terminal.ansiBrightBlack": "#2f6b43",
    "terminal.ansiBrightRed": "#ff8a7a",
    "terminal.ansiBrightGreen": "#aaffbe",
    "terminal.ansiBrightYellow": "#ffe08a",
    "terminal.ansiBrightBlue": "#5fd68f",
    "terminal.ansiBrightMagenta": "#e0ffe0",
    "terminal.ansiBrightCyan": "#d2ffdc",
    "terminal.ansiBrightWhite": "#e6ffea",

    "gitDecoration.addedResourceForeground": "#6eff96",
    "gitDecoration.modifiedResourceForeground": "#ffcd50",
    "gitDecoration.deletedResourceForeground": "#ff5f50",
    "gitDecoration.untrackedResourceForeground": "#aaffbe",
    "gitDecoration.ignoredResourceForeground": "#2f6b43",
    "diffEditor.insertedTextBackground": "#6eff9620",
    "diffEditor.removedTextBackground": "#ff5f5020",

    "notifications.background": "#030f06",
    "notifications.border": "#14461f",
    "notificationCenterHeader.background": "#04180a",
    "peekView.border": "#6eff96",
    "peekViewEditor.background": "#030f06",
    "peekViewResult.background": "#020a04",
    "peekViewTitle.background": "#04180a",
    "pickerGroup.border": "#14461f",
    "pickerGroup.foreground": "#ffcd50",
    "quickInput.background": "#030f06",
    "quickInputList.focusBackground": "#0a5023",
    "textLink.foreground": "#6eff96",
    "textLink.activeForeground": "#aaffbe",
    "textCodeBlock.background": "#04180a",
    "debugToolBar.background": "#030f06",
    "welcomePage.background": "#020a04",
    "walkThrough.embeddedEditorBackground": "#030f06"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#3c8c55", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.other"], "settings": { "foreground": "#ffcd50" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#5fd68f" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#aaffbe" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#ffe08a" } },
    { "scope": ["variable", "meta.definition.variable.name", "support.variable"], "settings": { "foreground": "#96ebaa" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#c8ffc8" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic"], "settings": { "foreground": "#6eff96" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#d2ffdc", "fontStyle": "bold" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#ffcd50" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#aaffbe", "fontStyle": "italic" } },
    { "scope": ["support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#96ebaa" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#6eff96", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#aaffbe" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#6eff96" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#ff5f50" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ff5f50" } },
    { "scope": ["meta.diff.header", "meta.diff.range"], "settings": { "foreground": "#ffcd50" } },
    { "scope": ["source.rust meta.attribute", "meta.annotation"], "settings": { "foreground": "#3cb371" } },
    { "scope": ["entity.name.namespace", "entity.name.module", "storage.type.rust"], "settings": { "foreground": "#c8ffc8" } }
  ],
  "semanticTokenColors": {
    "function": "#6eff96",
    "method": "#6eff96",
    "type": "#d2ffdc",
    "class": "#d2ffdc",
    "struct": "#d2ffdc",
    "enum": "#d2ffdc",
    "interface": "#d2ffdc",
    "variable": "#96ebaa",
    "parameter": "#c8ffc8",
    "property": "#96ebaa",
    "keyword": "#ffcd50",
    "string": "#aaffbe",
    "number": "#ffe08a",
    "comment": "#3c8c55",
    "macro": "#ffcd50",
    "lifetime": "#ffe08a",
    "namespace": "#c8ffc8"
  }
}
